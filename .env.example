# Explicitly set false for live mode. Never prefix secrets with VITE_.
VITE_DEMO_MODE=true
DEMO_MODE=true
# Free sources are the default; no football API key required.
FOOTBALL_PROVIDER=free-football
# Only required when FOOTBALL_PROVIDER=api-football
API_FOOTBALL_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SYNC_SECRET=
SUPPORTED_LEAGUE_ID=39
# Season start year; the free provider imports this and four earlier seasons.
FOOTBALL_SEASON=2026

# Optional recent bookmaker feed. Leave empty for free periodic CSV snapshots.
# Get your own key at https://the-odds-api.com/ (server-only).
ODDS_API_KEY=
ODDS_REGION=eu
# One h2h market + one region = 1 credit per refresh. Shared across all visitors.
# 7200 seconds: at most about 372 refreshes in a 31-day month (plus cold-cache retries).
# 300 seconds requires a larger quota; never presented as a free unlimited live feed.
ODDS_CACHE_SECONDS=7200
